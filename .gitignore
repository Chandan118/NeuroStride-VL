# NeuroStride-VL Git Ignore Rules
# ================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv
.conda

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System
.DS_Store
Thumbs.db

# Logs
*.log
logs/
*.log.*

# Training outputs
models/checkpoints/*
!models/checkpoints/.gitkeep
models/trt/*
!models/trt/.gitkeep

# Data
data/robots/*.urdf
data/scenarios/*.xml
!data/robots/.gitkeep
!data/scenarios/.gitkeep

# Temporary files
*.tmp
*.temp
.cache/
.cache

# MuJoCo
.mujoco/
mjkey.txt

# ROS2
build/
install/
log/
colcon_*

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Local config
configs/local.yaml

# Key files
*.pem
*.key
*.p12

# Camera test
test_video.avi
test_frame.png
