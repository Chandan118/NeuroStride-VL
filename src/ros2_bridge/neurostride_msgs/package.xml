<?xml version="1.0"?>
<?xml-model href="http://ros.org/rdfschema/package-schema-1.0.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>neurostride_msgs</name>
  <version>0.1.0</version>
  <description>Custom messages for NeuroStride-VL bipedal robot framework</description>
  <maintainer email="your-email@example.com">NeuroStride-VL Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rosidl_default_generators</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
